# Optional. Copy to .env for `docker compose`. All have safe defaults.
# Google PageSpeed Insights key — raises PSI rate limits (25k/day). Optional.
PAGESPEED_API_KEY=

# ── Phase 3: Master Audit V3 — Performance / PageSpeed ──────────────────
# Feature flag: enable the V3 pipeline (default: false, Phase 1+2 only)
MASTER_AUDIT_V3_ENABLED=false
# Feature flag: enable PSI provider within V3 pipeline (default: true when V3 on)
MASTER_AUDIT_PSI_ENABLED=true
# Max URLs to test with PSI per audit session (default: 20)
PSI_SAMPLE_LIMIT=20
# Strategies to run: "mobile" or "mobile,desktop" (default: "mobile")
PSI_STRATEGIES=mobile
