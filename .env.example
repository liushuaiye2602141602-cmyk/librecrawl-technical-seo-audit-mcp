# Optional. Copy to .env for `docker compose`. All have safe defaults.
# Google PageSpeed Insights key — raises PSI rate limits (25k/day). Optional.
PAGESPEED_API_KEY=

# ── Phase 3: Master Audit V3 — Performance / PageSpeed ──────────────────
# Feature flag: enable the V3 pipeline (default: false, Phase 1+2 only)
MASTER_AUDIT_V3_ENABLED=false
# Feature flag: enable PSI provider within V3 pipeline (default: true when V3 on)
MASTER_AUDIT_PSI_ENABLED=true
# Max URLs to test with PSI per audit session (default: 20)
PSI_SAMPLE_LIMIT=20
# Strategies to run: "mobile" or "mobile,desktop" (default: "mobile")
PSI_STRATEGIES=mobile

# Google Search Console V3 provider. Requires a short-lived OAuth 2.0 access
# token authorized for the property with webmasters.readonly scope.
MASTER_AUDIT_GSC_ENABLED=true
GSC_ACCESS_TOKEN=
# URL-prefix property (include trailing slash) or sc-domain: property.
GSC_SITE_URL=
# Bounded URL Inspection sample and Search Analytics row cap.
GSC_INSPECTION_LIMIT=20
GSC_ANALYTICS_MAX_ROWS=50000

# Semrush Backlinks API v4 (paid API units; v4 key required).
MASTER_AUDIT_SEMRUSH_ENABLED=true
SEMRUSH_API_KEY=
# Optional; defaults to the audit base URL hostname.
SEMRUSH_TARGET=
SEMRUSH_LOST_LINK_LIMIT=100

# GA4 Admin/Data APIs. Requires analytics.readonly OAuth access.
MASTER_AUDIT_GA4_ENABLED=true
GA4_ACCESS_TOKEN=
GA4_PROPERTY_ID=

# Explicit local Apache/Nginx/JSON access log file (read-only).
MASTER_AUDIT_SERVER_LOGS_ENABLED=true
SERVER_LOG_PATH=
SERVER_LOG_MAX_LINES=1000000

# Read-only, administrator-generated WordPress audit snapshot.
MASTER_AUDIT_WORDPRESS_ENABLED=false
WP_AUDIT_EXPORT_PATH=
WP_AUDIT_MAX_AGE_HOURS=168

# Optional portable baseline for Rule 74 before/after crawl comparison.
# Keep this file on persistent storage when running in a container.
AUDIT_SNAPSHOT_BASELINE_PATH=
# Optional snapshot/diff output directory; defaults to REPORTS_DIR.
AUDIT_SNAPSHOT_OUTPUT_DIR=
